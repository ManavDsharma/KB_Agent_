          "expect": {"route": "plan", "tier": "confirm", "contains": ["Rohit Malhotra", "Priya Nair", "Available → Not available"]}
        },
        {"say": "yes", "expect": {"route": "plan_execute", "contains": ["Updated 2 records"]}}
      ],
      "expect_data": [
        {"table": "roster", "key": "1", "day": "{day}", "equals": "N"},
        {"table": "roster", "key": "3", "day": "{day}", "equals": "N"},
        {"table": "roster", "key": "4", "day": "{day}", "equals": "Y"}
      ]
    },
