{
  "_about": "Cases for dev/evaluate.py. Each case is a conversation on in-memory sample data. 'draft' is what a correct planner model would return: it is used offline and ignored with --live (the real model is used instead). expect.route is the router/agent route (plan, plan_resume, plan_execute, entity_update, llm ...), expect.tier is execute | confirm | ask | error | fallback | noop. Templates: {day} a working day number, {iso_day} that day as YYYY-MM-DD, {month_name}, {today}.",
  "cases": [
    {
      "id": "fast-single-field",
      "category": "fast path (no model)",
      "turns": [
        {
          "say": "Update INC0000259 priority to P2",
          "expect": {"route": "entity_update", "planner_calls": 0, "tokens": 0, "contains": ["Updated INC0000259", "P2-High"]}
        }
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"}]
    },
    {
      "id": "fast-close-it",
      "category": "fast path (no model)",
      "turns": [
        {"say": "Show INC0000259", "expect": {"route": "entity_view", "planner_calls": 0}},
        {"say": "close it", "expect": {"route": "entity_update", "planner_calls": 0, "tokens": 0}}
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "state", "equals": "Closed"}]
    },
    {
      "id": "fast-assign",
      "category": "fast path (no model)",
      "turns": [
        {"say": "Assign INC0000259 to Rohit", "expect": {"route": "entity_update", "planner_calls": 0}}
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "assigned_to", "equals": "rohit.malhotra@abc.com"}]
    },
    {
      "id": "read-two-fields-is-a-read",
      "category": "fast path (no model)",
      "turns": [
        {"say": "What is the priority and urgency of INC0000259?", "expect": {"route": "entity_fields", "planner_calls": 0, "tokens": 0}}
      ]
    },

    {
      "id": "screenshot-both-fields",
      "category": "several fields on one record",
      "turns": [
        {
          "say": "Set both Priority and urgency of the INC0000259 to High",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "High", "urgency": "High"}}],
          "expect": {"route": "plan", "tier": "execute", "type": "update_confirmation", "planner_calls": 1, "contains": ["Updated INC0000259", "Priority: P3-Medium → P2-High", "Urgency: Low → High"]}
        }
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"},
        {"table": "incidents", "key": "INC0000259", "field": "urgency", "equals": "High"}
      ]
    },
    {
      "id": "fields-joined-by-comma",
      "category": "several fields on one record",
      "turns": [
        {
          "say": "Update INC0000259 priority High, urgency High",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "High", "urgency": "High"}}],
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "urgency", "equals": "High"}]
    },
    {
      "id": "priority-and-assignee",
      "category": "several fields on one record",
      "turns": [
        {
          "say": "Set priority to High and assign INC0000259 to Rohit",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "High", "assigned_to": "Rohit"}}],
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"},
        {"table": "incidents", "key": "INC0000259", "field": "assigned_to", "equals": "rohit.malhotra@abc.com"}
      ]
    },
    {
      "id": "fields-with-context",
      "category": "several fields on one record",
      "turns": [
        {"say": "Show INC0000259", "expect": {"route": "entity_view"}},
        {
          "say": "Set priority and urgency to high",
          "draft": [{"action": "update", "record": "incident", "targets": [], "changes": {"priority": "high", "urgency": "high"}}],
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"}]
    },
    {
      "id": "category-matrix-two-fields",
      "category": "several fields on one record",
      "turns": [
        {
          "say": "Set impact to High and urgency to High for Issue-1",
          "draft": [{"action": "update", "record": "issue", "targets": ["Issue-1"], "changes": {"impact": "High", "urgency": "High"}}],
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated Issue-1"]}
        }
      ],
      "expect_data": [
        {"table": "issues", "key": "Issue-1", "field": "impact", "equals": "High"},
        {"table": "issues", "key": "Issue-1", "field": "urgency", "equals": "High"}
      ]
    },
    {
      "id": "verb-the-router-has-no-pattern-for",
      "category": "several fields on one record",
      "turns": [
        {
          "say": "bump INC0000259 to high priority",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "high"}}],
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"}]
    },
    {
      "id": "paraphrase-two-fields",
      "category": "several fields on one record",
      "live_only": true,
      "turns": [
        {
          "say": "please make INC0000259 high priority and also high urgency",
          "expect": {"route": "plan", "tier": "execute", "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"},
        {"table": "incidents", "key": "INC0000259", "field": "urgency", "equals": "High"}
      ]
    },

    {
      "id": "ask-for-the-target-then-finish",
      "category": "asking only for what is missing",
      "turns": [
        {
          "say": "Set priority to High and urgency to Low",
          "draft": [{"action": "update", "record": "incident", "targets": [], "changes": {"priority": "High", "urgency": "Low"}}],
          "expect": {"route": "plan", "tier": "ask", "type": "question", "contains": ["Which incident"]}
        },
        {
          "say": "INC0000259",
          "expect": {"route": "plan_resume", "tier": "execute", "planner_calls": 0, "tokens": 0, "contains": ["Updated INC0000259"]}
        }
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"},
        {"table": "incidents", "key": "INC0000259", "field": "urgency", "equals": "Low"}
      ]
    },
    {
      "id": "ask-for-missing-values",
      "category": "asking only for what is missing",
      "turns": [
        {
          "say": "Set priority and urgency of INC0000259",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "", "urgency": ""}}],
          "expect": {"route": "plan", "tier": "ask", "contains": ["What should the priority be"]}
        },
        {"say": "High", "expect": {"route": "plan_resume", "tier": "ask", "contains": ["What should the urgency be"]}},
        {"say": "Low", "expect": {"route": "plan_resume", "tier": "execute", "contains": ["Updated INC0000259"]}}
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"},
        {"table": "incidents", "key": "INC0000259", "field": "urgency", "equals": "Low"}
      ]
    },
    {
      "id": "invalid-value-offers-the-valid-ones",
      "category": "asking only for what is missing",
      "turns": [
        {
          "say": "Set priority to Urgent and urgency to High on INC0000259",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259"], "changes": {"priority": "Urgent", "urgency": "High"}}],
          "expect": {"route": "plan", "tier": "ask", "contains": ["isn't a valid priority"]}
        },
        {"say": "2", "expect": {"route": "plan_resume", "tier": "execute", "contains": ["Updated INC0000259"]}}
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "priority", "equals": "P2-High"}]
    },

    {
      "id": "close-two-then-confirm",
      "category": "several records (confirmation)",
      "turns": [
        {
          "say": "Close INC0000259 and INC0000260",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259", "INC0000260"], "changes": {"state": "Closed"}}],
          "expect": {"route": "plan", "tier": "confirm", "confirmation": true, "contains": ["Here's what I'll change", "INC0000259", "INC0000260"]}
        },
        {"say": "yes", "expect": {"route": "plan_execute", "planner_calls": 0, "tokens": 0, "contains": ["Updated 2 records"]}}
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "state", "equals": "Closed"},
        {"table": "incidents", "key": "INC0000260", "field": "state", "equals": "Closed"}
      ]
    },
    {
      "id": "close-two-then-cancel",
      "category": "several records (confirmation)",
      "turns": [
        {
          "say": "Close INC0000259 and INC0000260",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259", "INC0000260"], "changes": {"state": "Closed"}}],
          "expect": {"route": "plan", "tier": "confirm"}
        },
        {"say": "cancel", "expect": {"route": "plan_cancel", "contains": ["won't change anything"]}}
      ],
      "expect_data": [
        {"table": "incidents", "key": "INC0000259", "field": "state", "equals": "New"},
        {"table": "incidents", "key": "INC0000260", "field": "state", "equals": "In Progress"}
      ]
    },
    {
      "id": "unknown-record-in-a-batch",
      "category": "several records (confirmation)",
      "turns": [
        {
          "say": "Close INC0000259 and INC0009999",
          "draft": [{"action": "update", "record": "incident", "targets": ["INC0000259", "INC0009999"], "changes": {"state": "Closed"}}],
          "expect": {"route": "plan", "tier": "error", "contains": ["didn't change anything", "INC0009999"]}
        }
      ],
      "expect_data": [{"table": "incidents", "key": "INC0000259", "field": "state", "equals": "New"}]
    },

    {
      "id": "roster-two-people-one-day",
      "category": "roster availability",
      "turns": [
        {
          "say": "Mark Rohit and Priya unavailable on {iso_day}",
